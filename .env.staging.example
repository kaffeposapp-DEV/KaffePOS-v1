# KaffePOS frontend + smoke staging environment template.
# Placeholders only. Do not commit real secrets.

# A. Minimal staging required (core app smoke without external providers)
VITE_APP_ENV=staging
VITE_STAGING_PROFILE=minimal
VITE_API_BASE_URL=https://staging-api.example.com
VITE_ANALYTICS_ENABLED=false
VITE_MIDTRANS_IS_PRODUCTION=false

# Smoke runner env (local only; do not commit real values)
KAFFEPOS_STAGING_API_URL=https://staging-api.example.com
KAFFEPOS_STAGING_FRONTEND_URL=https://staging.example.com
KAFFEPOS_OWNER_EMAIL=owner-staging@example.com
KAFFEPOS_OWNER_PASSWORD=change-me
KAFFEPOS_TEST_CASHIER_EMAIL=cashier-staging@example.com
KAFFEPOS_TEST_CASHIER_PASSWORD=change-me
KAFFEPOS_TEST_EMAIL_TO=test-recipient@example.com
KAFFEPOS_STOCK_SMOKE_CONFIRM=1

# B. Full staging required (production-candidate external provider verification)
# Required only when VITE_STAGING_PROFILE=full and STAGING_PROFILE=full/unset.
VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_CLARITY_PROJECT_ID=change-me
VITE_PUBLIC_ASSET_BASE_URL=https://assets.example.com
VITE_MIDTRANS_CLIENT_KEY=SB-Mid-client-change-me

# Feature flags
VITE_AFFILIATE_REFERRAL_ENABLED=false
VITE_REFERRAL_ENABLED=false
VITE_AFFILIATE_ENABLED=false
VITE_ADMIN_COMMISSION_ENABLED=false

# C. Optional integrations skipped in minimal mode
# GA4, Clarity, Midtrans Snap client key, and public asset CDN may remain placeholders in minimal staging.

# Frontend payment provider only; no Duitku secrets in frontend
VITE_PAYMENT_GATEWAY_PROVIDER=duitku

# Payment staging profile (Duitku sandbox)
# STAGING_PROFILE=payment
# VITE_STAGING_PROFILE=payment
# VITE_PAYMENT_GATEWAY_PROVIDER=duitku
