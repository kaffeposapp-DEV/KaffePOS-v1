# Coolify frontend (staging "minimal" profile) — TEMPLATE
#
# Copy to `coolify.frontend.minimal.env` (gitignored) and fill in real values.
# All VITE_* values are baked into the public bundle, so they are NOT secret —
# but keep deploy-specific files out of git for consistency.

NIXPACKS_NODE_VERSION=22

VITE_APP_ENV=staging
VITE_STAGING_PROFILE=minimal
VITE_API_BASE_URL=https://api.kaffepos.my.id

VITE_ANALYTICS_ENABLED=false

VITE_AFFILIATE_REFERRAL_ENABLED=false
VITE_REFERRAL_ENABLED=false
VITE_AFFILIATE_ENABLED=false
VITE_ADMIN_COMMISSION_ENABLED=false
# Informational only (analytics tag); the backend decides the real gateway.
VITE_PAYMENT_GATEWAY_PROVIDER=doku
