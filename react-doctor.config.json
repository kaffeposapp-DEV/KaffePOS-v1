{
  "$schema": "https://react.doctor/config.schema.json",
  "ignore": {
    "files": [
      "android/**",
      "dist/**",
      "coverage/**",
      "node_modules/**",
      "artifacts/**",
      "backups/**",
      "tmp/**",
      "**/*.md",
      "**/*.bak"
    ]
  },
  "rules": {
    "deslop/unused-file": "off",
    "deslop/unused-export": "off",
    "deslop/unused-dependency": "off",
    "react-doctor/aria-role": "off",
    "react-doctor/async-await-in-loop": "off",
    "react-doctor/async-defer-await": "off",
    "react-doctor/async-parallel": "off",
    "react-doctor/button-has-type": "off",
    "react-doctor/click-events-have-key-events": "off",
    "react-doctor/client-localstorage-no-version": "off",
    "react-doctor/control-has-associated-label": "off",
    "react-doctor/design-no-bold-heading": "off",
    "react-doctor/design-no-em-dash-in-jsx-text": "off",
    "react-doctor/design-no-redundant-padding-axes": "off",
    "react-doctor/design-no-redundant-size-axes": "off",
    "react-doctor/design-no-space-on-flex-children": "off",
    "react-doctor/design-no-three-period-ellipsis": "off",
    "react-doctor/effect-needs-cleanup": "off",
    "react-doctor/exhaustive-deps": "off",
    "react-doctor/js-cache-storage": "off",
    "react-doctor/js-combine-iterations": "off",
    "react-doctor/js-flatmap-filter": "off",
    "react-doctor/js-hoist-intl": "off",
    "react-doctor/js-index-maps": "off",
    "react-doctor/js-min-max-loop": "off",
    "react-doctor/js-set-map-lookups": "off",
    "react-doctor/js-tosorted-immutable": "off",
    "react-doctor/jsx-no-new-object-as-prop": "off",
    "react-doctor/label-has-associated-control": "off",
    "react-doctor/no-adjust-state-on-prop-change": "off",
    "react-doctor/no-array-index-as-key": "off",
    "react-doctor/no-array-index-key": "off",
    "react-doctor/no-autofocus": "off",
    "react-doctor/no-barrel-import": "off",
    "react-doctor/no-cascading-set-state": "off",
    "react-doctor/no-chain-state-updates": "off",
    "react-doctor/no-derived-state": "off",
    "react-doctor/no-derived-state-effect": "off",
    "react-doctor/no-derived-useState": "off",
    "react-doctor/no-effect-chain": "off",
    "react-doctor/no-event-handler": "off",
    "react-doctor/no-fetch-in-effect": "off",
    "react-doctor/no-giant-component": "off",
    "react-doctor/no-gray-on-colored-background": "off",
    "react-doctor/no-initialize-state": "off",
    "react-doctor/no-inline-bounce-easing": "off",
    "react-doctor/no-inline-exhaustive-style": "off",
    "react-doctor/no-noninteractive-element-interactions": "off",
    "react-doctor/no-pass-data-to-parent": "off",
    "react-doctor/no-render-in-render": "off",
    "react-doctor/no-reset-all-state-on-prop-change": "off",
    "react-doctor/no-static-element-interactions": "off",
    "react-doctor/no-z-index-9999": "off",
    "react-doctor/only-export-components": "off",
    "react-doctor/prefer-dynamic-import": "off",
    "react-doctor/prefer-tag-over-role": "off",
    "react-doctor/prefer-useReducer": "off",
    "react-doctor/rendering-hydration-mismatch-time": "off",
    "react-doctor/rendering-hydration-no-flicker": "off",
    "react-doctor/rerender-lazy-state-init": "off",
    "react-doctor/rerender-state-only-in-handlers": "off",
    "react-doctor/server-sequential-independent-await": "off"
  }
}
