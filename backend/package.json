{
  "name": "kaffepos-backend",
  "version": "1.0.0",
  "private": true,
  "description": "KaffePOS backend API for PostgreSQL migration",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:coolify": "node dist/index.js",
    "check": "npm run typecheck && npm run build",
    "migrate": "node scripts/run-migrations.mjs",
    "backup:critical": "node scripts/backup-critical-data.mjs",
    "deploy:kds": "cd .. && bash scripts/deploy-kds-one-command.sh"
  },
  "dependencies": {
    "@sentry/node": "^10.51.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "midtrans-client": "^1.4.3",
    "pg": "^8.13.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/node": "^24.6.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
