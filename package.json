{
  "name": "kaffepos",
  "version": "2.0.0",
  "private": true,
  "description": "KaffePOS - Modern POS System for Coffee Shops",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:web",
    "build:web": "npx vite build",
    "build:mobile": "VITE_APP_TARGET=mobile npx vite build",
    "deploy:kds": "bash scripts/deploy-kds-one-command.sh",
    "preview": "vite preview",
    "test": "npm run test:all",
    "test:frontend": "vitest run",
    "test:backend": "vitest run --config vitest.backend.config.ts",
    "test:all": "npm run test:frontend && npm run test:backend",
    "check": "npm run lint && npm run typecheck && npm run test:all && npm run build:web && npm --prefix backend run check",
    "smoke:staging:cashier": "node scripts/smoke-owner-cashier.mjs",
    "smoke:staging:offline-sync": "node scripts/smoke-offline-sync.mjs",
    "smoke:staging:stock": "node scripts/smoke-stock-flow.mjs",
    "smoke:production:readiness": "node scripts/smoke-production-readiness.mjs",
    "smoke:production:billing": "node scripts/smoke-billing-production.mjs",
    "smoke:mobile:fresh-login": "node scripts/smoke-mobile-fresh-login.mjs",
    "release:verify-config": "node scripts/verify-release-config.mjs",
    "backup:postgres": "bash scripts/backup-postgres.sh",
    "android:usb-debug": "bash scripts/android-usb-debug-build.sh",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "cap:run": "npx cap run android",
    "build-apk": "npm run build:mobile && npx cap sync android && npx cap open android",
    "build-apk-debug": "npm run build:mobile && npx cap sync android && cd android && ./gradlew assembleDebug && echo '✅ APK: android/app/build/outputs/apk/debug/app-debug.apk'",
    "build-apk-release": "npm run build:mobile && npx cap sync android && cd android && ./gradlew assembleRelease && echo '✅ APK: android/app/build/outputs/apk/release/app-release.apk'"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/app": "^6.0.1",
    "@capacitor/browser": "^6.0.6",
    "@capacitor/core": "^6.1.2",
    "@capacitor/filesystem": "^6.0.1",
    "@capacitor/haptics": "^6.0.1",
    "@capacitor/keyboard": "^6.0.1",
    "@capacitor/network": "^6.0.1",
    "@capacitor/preferences": "^6.0.4",
    "@capacitor/share": "^6.0.1",
    "@capacitor/splash-screen": "^6.0.1",
    "@capacitor/status-bar": "^6.0.1",
    "@capacitor/toast": "^6.0.1",
    "@kduma-autoid/capacitor-bluetooth-printer": "^0.2.1",
    "@sentry/react": "^10.51.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.576.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.1",
    "recharts": "^2.12.7",
    "tailwind-merge": "^2.3.0",
    "zod": "^4.3.6",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/deno": "^2.5.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/recharts": "^1.8.9",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.2",
    "autoprefixer": "^10.4.19",
    "esbuild": "^0.28.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.0.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "5.4.5",
    "vite": "^8.0.3",
    "vitest": "^4.1.2"
  },
  "overrides": {
    "tar": "^7.5.1"
  }
}
