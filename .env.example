# KaffePOS v2 — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ── Backend API ───────────────────────────────────────────────────
# Development web can leave this empty and rely on the Vite proxy to localhost:8787.
# Production default is https://api.kaffepos.my.id when this value is empty.
# Set this only when you want to override that behavior.
VITE_API_BASE_URL=

# ── App Config ────────────────────────────────────────────────────
VITE_APP_NAME=KaffePOS
VITE_APP_VERSION=2.0.0
VITE_CLOUDFLARE_CDN_BASE_URL=https://cdn.kaffepos.my.id
VITE_CLOUDFLARE_IMAGE_DELIVERY_URL=
# Production analytics IDs for KaffePOS:
# Google Analytics Measurement ID: G-VNQJ3XPCGG
# Microsoft Clarity Project ID: wf7x39iiqr
VITE_GA_MEASUREMENT_ID=G-VNQJ3XPCGG
VITE_CLARITY_PROJECT_ID=wf7x39iiqr
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0
# Midtrans secret/server keys are backend-only. Do not add VITE_MIDTRANS_* keys.

# ── Affiliate & Referral Safe Rollout Flags ───────────────────────
# Defaults are off. Enable gradually per docs/RELEASE_CHECKLIST_AFFILIATE_REFERRAL.md.
AFFILIATE_REFERRAL_ENABLED=false
REFERRAL_ENABLED=false
AFFILIATE_ENABLED=false
ADMIN_COMMISSION_ENABLED=false
REFERRAL_COMMISSION_CREATION_ENABLED=false
VITE_AFFILIATE_REFERRAL_ENABLED=false
VITE_REFERRAL_ENABLED=false
VITE_AFFILIATE_ENABLED=false
VITE_ADMIN_COMMISSION_ENABLED=false

# Frontend payment provider only; no Duitku secrets in frontend
VITE_PAYMENT_GATEWAY_PROVIDER=duitku
