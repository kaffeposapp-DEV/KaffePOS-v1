# KaffePOS v2 — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ── Supabase ──────────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Backend API ───────────────────────────────────────────────────
# Development web can leave this empty and rely on the Vite proxy to localhost:8787.
# Production default is https://api.kaffepos.my.id when this value is empty.
# Set this only when you want to override that behavior.
VITE_API_BASE_URL=

# ── App Config ────────────────────────────────────────────────────
VITE_APP_NAME=KaffePOS
VITE_APP_VERSION=2.0.0
