# Coolify backend (staging "minimal" profile) — TEMPLATE
#
# Copy to `coolify.backend.minimal.env` (gitignored) and fill in real values.
# NEVER commit the filled-in file. Generate token/key secrets with:
#   PII_ENCRYPTION_KEY / *_TOKEN : openssl rand -hex 32
# (Auth uses opaque DB-backed sessions — there is no JWT/SESSION secret.)

NODE_ENV=staging
STAGING_PROFILE=minimal

PORT=8787
SERVICE_NAME=kaffepos-backend-staging
APP_VERSION=1.0.0
LOG_LEVEL=info

ADMIN_EMAILS=admin@example.com

WEB_BASE_URL=https://kaffepos.my.id
API_BASE_URL=https://api.kaffepos.my.id

DB_HOST=kaffepos-postgres
DB_PORT=5432
DB_NAME=kaffepos_production
DB_USER=kaffepos
DB_PASSWORD=__SET_STRONG_DB_PASSWORD__
DB_SSL=false

DATABASE_URL=postgresql://kaffepos:__SET_STRONG_DB_PASSWORD__@kaffepos-postgres:5432/kaffepos_production

# Optional. If unset, the PII encryption key derives from DATABASE_URL — meaning
# a DB password rotation also rotates the key. Pin a stable value before rotating
# DB creds if affiliate payout/bank PII already exists. openssl rand -hex 32
PII_ENCRYPTION_KEY=

SESSION_TTL_DAYS=30
EMAIL_CODE_TTL_MINUTES=10
PASSWORD_RESET_TTL_MINUTES=15

# Set true once real DOKU credentials are filled in below.
PAYMENT_INTEGRATION_ENABLED=true
SUBSCRIPTION_PAYMENT_MODE=auto

CORS_ORIGIN=https://kaffepos.my.id,https://www.kaffepos.my.id,https://api.kaffepos.my.id

AFFILIATE_REFERRAL_ENABLED=false
REFERRAL_ENABLED=false
AFFILIATE_ENABLED=false
ADMIN_COMMISSION_ENABLED=false
REFERRAL_COMMISSION_CREATION_ENABLED=false
# ── Payment gateway: DOKU Checkout (hosted page) ──────────────────
PAYMENT_GATEWAY_PROVIDER=doku
DOKU_ENVIRONMENT=sandbox
DOKU_CLIENT_ID=__SET_DOKU_CLIENT_ID__
DOKU_SECRET_KEY=__SET_DOKU_SECRET_KEY__
# Confirm the exact host for your DOKU account; these are the common defaults.
DOKU_SANDBOX_BASE_URL=https://api-sandbox.doku.com
DOKU_PRODUCTION_BASE_URL=https://api.doku.com
# Customer redirect after payment. Register the notification (webhook) URL
# https://api.kaffepos.my.id/api/webhooks/doku in the DOKU Back Office.
DOKU_CALLBACK_URL=https://kaffepos.my.id/settings?billing=doku-return
DOKU_NOTIFICATION_PATH=/api/webhooks/doku
DOKU_PAYMENT_DUE_MINUTES=60
STAGING_REPAIR_TOKEN=__GENERATE_WITH_openssl_rand_hex_32__
