# Coolify backend (staging "minimal" profile) — TEMPLATE
#
# Copy to `coolify.backend.minimal.env` (gitignored) and fill in real values.
# NEVER commit the filled-in file. Generate secrets with:
#   JWT_SECRET / SESSION_SECRET : openssl rand -base64 48
#   ENCRYPTION_KEY / *_TOKEN    : openssl rand -hex 32

NODE_ENV=staging
STAGING_PROFILE=minimal

PORT=8787
SERVICE_NAME=kaffepos-backend-staging
APP_VERSION=1.0.0
LOG_LEVEL=info

ADMIN_EMAILS=admin@example.com

WEB_BASE_URL=https://kaffepos.my.id
API_BASE_URL=https://api.kaffepos.my.id

DB_HOST=kaffepos-postgres
DB_PORT=5432
DB_NAME=kaffepos_production
DB_USER=kaffepos
DB_PASSWORD=__SET_STRONG_DB_PASSWORD__
DB_SSL=false

DATABASE_URL=postgresql://kaffepos:__SET_STRONG_DB_PASSWORD__@kaffepos-postgres:5432/kaffepos_production

JWT_SECRET=__GENERATE_WITH_openssl_rand_base64_48__
SESSION_SECRET=__GENERATE_WITH_openssl_rand_base64_48__
ENCRYPTION_KEY=__GENERATE_WITH_openssl_rand_hex_32__

SESSION_TTL_DAYS=30
EMAIL_CODE_TTL_MINUTES=10
PASSWORD_RESET_TTL_MINUTES=15

PAYMENT_INTEGRATION_ENABLED=false
EMAIL_INTEGRATION_ENABLED=false
R2_STORAGE_ENABLED=false
ANALYTICS_SERVER_ENABLED=false

MIDTRANS_ENVIRONMENT=sandbox
MIDTRANS_SNAP_ENABLED=false
SUBSCRIPTION_PAYMENT_MODE=disabled

CORS_ORIGIN=https://kaffepos.my.id,https://www.kaffepos.my.id,https://api.kaffepos.my.id

AFFILIATE_REFERRAL_ENABLED=false
REFERRAL_ENABLED=false
AFFILIATE_ENABLED=false
ADMIN_COMMISSION_ENABLED=false
REFERRAL_COMMISSION_CREATION_ENABLED=false
PAYMENT_GATEWAY_PROVIDER=disabled
DUITKU_ENVIRONMENT=sandbox
DUITKU_MERCHANT_CODE=__SET_DUITKU_MERCHANT_CODE__
DUITKU_MERCHANT_KEY=__SET_DUITKU_SANDBOX_MERCHANT_KEY__
DUITKU_SANDBOX_BASE_URL=https://sandbox.duitku.com
DUITKU_PRODUCTION_BASE_URL=https://passport.duitku.com
DUITKU_CALLBACK_URL=https://api.kaffepos.my.id/api/webhooks/duitku
DUITKU_RETURN_URL=https://kaffepos.my.id/settings?billing=duitku-return
DUITKU_SUCCESS_URL=https://kaffepos.my.id/settings?billing=success&provider=duitku
DUITKU_PENDING_URL=https://kaffepos.my.id/settings?billing=pending&provider=duitku
DUITKU_FAILED_URL=https://kaffepos.my.id/settings?billing=failed&provider=duitku
DUITKU_EXPIRY_PERIOD_MINUTES=60
DUITKU_DEFAULT_PAYMENT_METHOD=VC
STAGING_REPAIR_TOKEN=__GENERATE_WITH_openssl_rand_hex_32__
